
// Function with conditional logic
#define int max(int x, int y) {
    if (x > y) {
        yield x;
    } else {
        yield y;

    }
}


#define int min(int x, int y) {
    if (x < y) {
        yield x;
    } 
    yield y;
}

#define string stringTest(int a, int b) {
    int result = a + b;

    string message = "The sum of " + a + " and " + b + " is: " + result;

    yield message;
}

print(stringTest(5, 10));             // Prints: The sum of 5 and 10 is: 15

print(max(30, 60));               // Prints: 30

print(min(60, 40));               // Prints: 30