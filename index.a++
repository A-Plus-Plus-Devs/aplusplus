numbers<int> = [1, 2, 3, 4, 5];
print("Array 'numbers' created\n");

int x = numbers[0];
print(x);
print("\n");

names<string> = ["Alice", "Bob", "Charlie"];
print("Array 'names' created\n");

print("About to call addFirst on names\n");
names.addFirst("Dylan");
print("Successfully called addFirst\n");