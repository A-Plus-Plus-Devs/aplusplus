print(date());           // Outputs: 2024-03-14
print(date("Y"));       // Outputs: 2024
print(date("M"));       // Outputs: 03
print(date("D"));       // Outputs: 14
print(date("Y", "M")); // Outputs: 2024-03
print(date("M", "D")); // Outputs: 03-14
print(date("Y", "D")); // Outputs: 2024-14

print(time());          // Outputs: 15:30:45
print(now());          // Outputs: 2024-03-14 15:30:45