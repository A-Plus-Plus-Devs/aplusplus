numbers<int> = [1, 2, 3, 4, 5];
int x = numbers[0];

print(x);
print("\n\n\n");

names<string> = ["Alice", "Bob", "Charlie"];

print(names[0]);
print("\n\n\n");

mixed<any> = [1, "two", yup];

print(mixed[1]);
print("\n\n\n");

floatArray<float> = [1.1, 2.2, 3.3];

print(floatArray[0]);
print("\n\n\n");

boolArray<boolean> = [yup, nope, yup];

print(boolArray[0]);
print("\n\n\n");

