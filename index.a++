names<string> = [];

int len = (int) input("Enter number of names: ");
int a = 2;

string name = "";

for (int i = 0; i < len; i++) {   
    name = input("Enter name: ");
    names.addLast(name);
}

names[1] = "Jake";

names.addLast("Bob");

print(names);

#define string greetUser(string name) {
    yield "Hello " + name;
}

print(greetUser("Paul"));