// Basic trigonometric functions (in radians)
print(sin(3.14159/2));    // Outputs: 1 (approximately)
print(cos(0));            // Outputs: 1
print(tan(3.14159/4));    // Outputs: 1 (approximately)

// Inverse trigonometric functions
print(asin(1));          // Outputs: 1.5708 (π/2)
print(acos(0));          // Outputs: 1.5708 (π/2)
print(atan(1));          // Outputs: 0.7854 (π/4)