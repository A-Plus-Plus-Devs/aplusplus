print(repeat("Hello", 4));       // Outputs: 4
print(sqrt(2));        // Outputs: 1.414213562

print(cbrt(27));       // Outputs: 3
print(cbrt(-8));       // Outputs: -2

print(root(16, 2));    // Outputs: 4 (same as sqrt)
print(root(27, 3));    // Outputs: 3 (same as cbrt)
print(root(16, 4));    // Outputs: 2 (fourth root)
print(root(-27, 3));   // Outputs: -3 (works with odd roots of negative numbers)