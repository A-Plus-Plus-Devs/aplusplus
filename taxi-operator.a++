print("*==================== Taxi Fare Calculator ==========================*\n\n\n");


float taxiCost = (float) input("How much is a single taxi ride? ");
int totalTaxiCapacity = (int) input("Total taxi capacity: ");
float paidByRow = (float) input("How much was paid for the entire row? ");
int peopleInRow = (int) input("How many people were in the row? ");

float totalExpectedIncome = taxiCost * totalTaxiCapacity;

float costForRow = taxiCost * peopleInRow;

float change = paidByRow - costForRow;

print("The total cost for the row: R" + costForRow);
print("The driver's money is: R" + costForRow);
print("The chnage for the row is: R" + change);
print("The total expected income from all taxis is: R" + totalExpectedIncome);

print("\n\n\n*==================== Taxi Fare Calculator ==========================*");


