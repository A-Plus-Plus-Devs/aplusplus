// Edge Cases and Additional Feature Tests for A++
// Each section tests different functionality in extreme cases
// Author: Paul Kabulu

/*
 * There are currently some errors that need to be checked, however, most edge cases have passed the tests... just 3 erros logged, 
 * they arent that detailed, so I cant really tell whats causing them - but all in all, the edge cases are working as intended
*/



// 1. Variable Declaration Edge Cases
print("=== Variable Declaration Edge Cases ===");
integer max_integer = 2147483647;    // Maximum 32-bit integer
integer min_integer = -2147483648;   // Minimum 32-bit integer
print("max: " + max_int);
print("min: " + min_int);

decimal very_small = 0.0000001;  // Very small decimal
print(very_small);

text empty = "";             // Empty text
print(empty);
text spaces = "   ";         // String with only spaces
print(spaces);

// 2. Operator Edge Cases
print("=== Operator Edge Cases ===");
print(5 / 2);                  // Integer division
print(2147483647 + 1);        // Integer overflow
print(-2147483648 - 1);       // Integer underflow
print(0 ** 0);                // Power with zero
print(0 ** 5);                // Zero to any power
print(1 ** 1000);             // One to large power
print((-2) ** 3);             // Negative number power

// 3. Complex Boolean Logic
print("=== Complex Boolean Logic ===");
print(facts && facts && facts);      // Multiple AND
print(cap || cap || facts);    // Multiple OR
print(!(facts && cap));         // NOT with parentheses
print(facts && !cap);           // NOT in expression
print(facts || (facts && cap));     // Operator precedence
print((facts || facts) && cap);   // Parentheses changing precedence

// 4. Nested Control Structures
print("=== Nested Control Structures ===");
if (facts) {
    if (facts) {
        print("Nested if - both facts");
    } else {
        print("This should not printeger 1");
    }
} else {
    print("This should not printeger 2");
}

// 5. For Loop Edge Cases
print("=== For Loop Edge Cases ===");
// Empty for loop
for (integer i = 0; i < 0; i = i + 1) {
    print("This should not printeger 3");
}

// Single iteration
for (integer i = 0; i < 1; i = i + 1) {
    print("Single iteration");
}

// Nested loops
for (integer i = 0; i < 2; i = i + 1) {
    for (integer j = 0; j < 2; j = j + 1) {
        print(i);
        print(j);
    }
}

// 6. Type Coercion Tests
print("=== Type Coercion Tests ===");
integer int_val = 42;
decimal decimal_val = 3.14;
print(int_val + decimal_val);    // Int + Decimal

// 7. Mixed Expression Tests
print("=== Mixed Expression Tests ===");
print((5 + 3 * 2 == 11) && facts);  // Arithmetic + Comparison + Logical
print(cap || (5 < 10 && 3 >= 2)); // Multiple comparisons and logical
print(!(5 + 5 != 10) && facts);    // Parentheses + NOT + Comparison + Logical
