// Function Test Suite for A++ Language
// Tests various aspects of function definition and usage

// 1. Basic Function Tests
print("=== Basic Function Tests ===");

// Simple function with no parameters
#define text sayHello() {
    yield "Hello from function!";
}
print(sayHello());

// Function with parameters
#define integer add(integer a, integer b) {
    yield a + b;
}
print("Sum: " + add(5, 3));

// 2. Return Type Tests
print("\n=== Return Type Tests ===");

#define integer getNumber() {
    yield 42;
}
print("Integer return: " + getNumber());

#define decimal getDecimal() {
    yield 3.14;
}
print("Decimal return: " + getDecimal());

#define text getString() {
    yield "test text";
}
print("String return: " + getString());

#define boolean getBoolean() {
    yield facts;
}
print("Boolean return: " + getBoolean());

// 3. Parameter Type Tests
print("\n=== Parameter Type Tests ===");

#define text combineStrings(text s1, text s2) {
    yield s1 + s2;
}
print("Combined text: " + combineStrings("Hello, ", "World!"));

#define decimal addNumbers(decimal x, decimal y) {
    yield x + y;
}
print("Decimal sum: " + addNumbers(3.14, 2.86));

// 4. Recursive Function Tests
print("\n=== Recursive Function Tests ===");

#define integer factorial(integer n) {
    if (n <= 1) {
        yield 1;
    }
    yield n * factorial(n - 1);
}
print("Factorial of 5: " + factorial(5));

// 5. Function Call Chain Tests
print("\n=== Function Call Chain Tests ===");

#define integer double(integer x) {
    yield x * 2;
}

#define integer triple(integer x) {
    yield x * 3;
}

#define integer quadruple(integer x) {
    yield double(double(x));
}

print("Double 5: " + double(5));
print("Triple 5: " + triple(5));
print("Quadruple 5: " + quadruple(5));

// 6. Scope Tests
print("\n=== Scope Tests ===");

integer globalVar = 10;

#define text testScope() {
    integer localVar = 20;
    print("Global var inside function: " + globalVar);
    print("Local var inside function: " + localVar);
    yield "Scope test complete";
}

print(testScope());
print("Global var outside function: " + globalVar);

print("\n=== Function Tests Complete ===");
