// Simple for loop test
// Author: Paul Kabulu

print("=== For Loop Test - Basic ===");

for (integer i = 0; i < 3; i++) {
    print(i);
}

print("=== For Loop Test - Nested ===");

for (integer i = 0; i < 3; i++) {
    for (integer j = 0; j < 3; j++) {
        print(i * j);
    }
}

print("=== Test Complete ===");
