{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "A++",
    "patterns": [
        { "include": "#comments" },
        { "include": "#keywords" },
        { "include": "#storage_types" },
        { "include": "#function_definition" },
        { "include": "#function_calls" },
        { "include": "#operators" },
        { "include": "#array_operations" },
        { "include": "#array_types" },
        { "include": "#parameters" },
        { "include": "#constants" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.aplusplus",
                    "match": "\\+|-|\\*|/|%|\\*\\*"
                },
                {
                    "name": "keyword.operator.comparison.aplusplus",
                    "match": "==|!=|>=|<=|>|<"
                },
                {
                    "name": "keyword.operator.logical.aplusplus",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.assignment.aplusplus",
                    "match": "="
                },
                {
                    "name": "punctuation.terminator.statement.aplusplus",
                    "match": ";"
                },
                {
                    "name": "punctuation.separator.parameter.aplusplus",
                    "match": ","
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.documentation.aplusplus",
                    "begin": "/\\*",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.comment.begin.aplusplus" }
                    },
                    "end": "\\*/",
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.comment.end.aplusplus" }
                    },
                    "patterns": [
                        {
                            "match": "^\\s*(\\*)(?!/)",
                            "captures": {
                                "1": { "name": "punctuation.definition.comment.aplusplus" }
                            }
                        }
                    ]
                },
                {
                    "name": "comment.line.double-slash.aplusplus",
                    "match": "//.*$"
                }
            ]
        },
        "keywords": {
            "patterns": [{
                "name": "keyword.control.aplusplus",
                "match": "\\b(if|else|for|yield|#define)\\b"
            }]
        },
        "storage_types": {
            "patterns": [{
                "name": "storage.type.aplusplus",
                "match": "\\b(text|integer|decimal|boolean|nothing|char|any)\\b"
            }]
        },
        "function_definition": {
            "patterns": [{
                "match": "(#define)\\s+(\\w+)\\s+(\\w+)\\s*\\(",
                "captures": {
                    "1": { "name": "keyword.control.aplusplus" },
                    "2": { "name": "storage.type.aplusplus" },
                    "3": { "name": "entity.name.function.aplusplus" }
                }
            }]
        },
        "function_calls": {
            "patterns": [{
                "match": "\\b(print|echo|add|inject|maximum|minimum|input|length|yap)\\b",
                "name": "support.function.builtin.aplusplus"
            },
            {
                "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
                "captures": {
                    "1": { "name": "entity.name.function.aplusplus" }
                }
            }]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.aplusplus",
                    "match": "\\b(cap|facts)\\b"
                },
                {
                    "name": "constant.language.aplusplus",
                    "match": "\\b(empty)\\b"
                },
                {
                    "name": "constant.numeric.aplusplus",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.aplusplus",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [{
                        "name": "constant.character.escape.aplusplus",
                        "match": "\\\\([\"\\\\nrt])"
                    }]
                },
                {
                    "name": "string.quoted.single.aplusplus",
                    "begin": "'",
                    "end": "'",
                    "patterns": [{
                        "name": "constant.character.escape.aplusplus",
                        "match": "\\\\(['\\\\nrt])"
                    }]
                }
            ]
        },
        "numbers": {
            "patterns": [{
                "name": "constant.numeric.aplusplus",
                "match": "\\b\\d+(\\.\\d+)?\\b"
            }]
        },
        "parameters": {
            "patterns": [{
                "match": "(\\w+)\\s+(\\w+)",
                "captures": {
                    "1": { "name": "storage.type.parameter.aplusplus" },
                    "2": { "name": "variable.parameter.aplusplus" }
                }
            }]
        },
        "identifiers": {
            "patterns": [{
                "name": "variable.other.aplusplus",
                "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
            }]
        }
    },
    "scopeName": "source.aplusplus"
}
